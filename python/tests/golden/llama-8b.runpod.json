{
  "template": {
    "name": "multihull-llama-8b",
    "imageName": "ghcr.io/acme/vllm-llama:1.4.0",
    "dockerStartCmd": "vllm serve meta-llama/Llama-3.1-8B-Instruct",
    "containerDiskInGb": 20,
    "ports": "8000/http",
    "env": [
      {
        "key": "VLLM_LOGGING_LEVEL",
        "value": "INFO"
      }
    ],
    "secretEnv": [
      {
        "key": "hf-token",
        "secret": "hf-token"
      }
    ],
    "isServerless": true
  },
  "endpoint": {
    "name": "multihull-llama-8b",
    "templateId": "{templateId}",
    "gpuIds": "NVIDIA L4,NVIDIA A10G,NVIDIA A100-SXM4-40GB",
    "gpuCount": 1,
    "workersMin": 1,
    "workersMax": 8,
    "idleTimeout": 5,
    "scalerType": "REQUEST_COUNT",
    "scalerValue": 32,
    "dataCenterIds": [
      "EU-RO-1",
      "EU-SE-1"
    ],
    "loadBalancer": {
      "port": 8000,
      "healthPath": "/health"
    },
    "allowedCudaVersions": []
  }
}
