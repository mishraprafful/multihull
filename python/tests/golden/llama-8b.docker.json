{
  "image": "ghcr.io/acme/vllm-llama:1.4.0",
  "command": [
    "vllm",
    "serve",
    "meta-llama/Llama-3.1-8B-Instruct"
  ],
  "name": "multihull-llama-8b-docker-local",
  "detach": true,
  "ports": {
    "8000/tcp": [
      "127.0.0.1",
      18080
    ]
  },
  "environment": {
    "VLLM_LOGGING_LEVEL": "INFO",
    "MOCK": "1"
  },
  "labels": {
    "multihull.dev/service": "llama-8b",
    "multihull.dev/provider": "docker-local",
    "multihull.dev/owner": "multihull",
    "multihull.dev/health-path": "/health"
  },
  "restart_policy": {
    "Name": "unless-stopped"
  },
  "healthcheck": {
    "test": [
      "CMD-SHELL",
      "curl -fsS http://localhost:8000/health || wget -qO- http://localhost:8000/health || exit 1"
    ],
    "interval": 10000000000,
    "timeout": 2000000000,
    "retries": 3,
    "start_period": 120000000000
  },
  "network": "multihull"
}
