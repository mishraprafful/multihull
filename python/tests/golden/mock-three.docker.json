{
  "image": "multihull-mock-server:dev",
  "command": null,
  "name": "multihull-mock-three-docker-a",
  "detach": true,
  "ports": {
    "8000/tcp": [
      "127.0.0.1",
      18001
    ]
  },
  "environment": {
    "MOCK_MODEL": "mock-llm"
  },
  "labels": {
    "multihull.dev/service": "mock-three",
    "multihull.dev/provider": "docker-a",
    "multihull.dev/owner": "multihull",
    "multihull.dev/health-path": "/health"
  },
  "restart_policy": {
    "Name": "unless-stopped"
  },
  "healthcheck": {
    "test": [
      "CMD-SHELL",
      "curl -fsS http://localhost:8000/health || wget -qO- http://localhost:8000/health || python3 -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)\" || exit 1"
    ],
    "interval": 10000000000,
    "timeout": 2000000000,
    "retries": 3,
    "start_period": 2000000000
  }
}
