---
const rows = [
  { y: 50, key: 'kubernetes', name: 'Kubernetes', payload: 'Deployment' },
  { y: 105, key: 'modal', name: 'Modal', payload: 'modal.App' },
  { y: 160, key: 'runpod', name: 'RunPod', payload: 'Endpoint' },
  { y: 215, key: 'baseten', name: 'Baseten', payload: 'Truss' },
  { y: 270, key: 'replicate', name: 'Replicate', payload: 'Deployment' },
];
const indent = '\u00a0\u00a0';
const yaml = ['name: llama-8b', 'container:', `${indent}image: ghcr.io/acme/vllm`, 'resources:', `${indent}gpu: [L4, A10G]`, 'targets: 5'];
---

<figure class="sp">
  <svg
    viewBox="0 0 960 320"
    role="img"
    aria-labelledby="sp-title sp-desc"
    aria-label="One multihull.yaml file fans out through five translators, one per provider, into native payloads: a Kubernetes Deployment, a Modal App, a RunPod Endpoint, a Baseten Truss and a Replicate Deployment."
  >
    <title id="sp-title">One spec, five native payloads</title>
    <desc id="sp-desc">
      The spec file on the left connects to five translator boxes in the middle.
      Each translator points to an abstract provider glyph on the right with the native payload name under it.
    </desc>

    <defs>
      <marker id="sp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path class="sp-arrowhead" d="M0 0L10 5L0 10z" />
      </marker>
    </defs>

    <text class="t2 head" x="135" y="22">one spec</text>
    <text class="t2 head" x="470" y="22">translators</text>
    <text class="t2 head" x="722" y="22">native payloads</text>

    <rect class="sp-card" x="40" y="85" width="190" height="150" rx="8" />
    <line class="sp-card-rule" x1="40" y1="110" x2="230" y2="110" />
    <text class="t1 file" x="52" y="98">multihull.yaml</text>
    {yaml.map((line, i) => <text class="t2 code" x="52" y={126 + i * 17}>{line}</text>)}

    {rows.map((r) => (
      <>
        <path class="sp-fan" d={`M230 160C315 160 315 ${r.y} 396 ${r.y}`} />
        <rect class="sp-box" x="400" y={r.y - 17} width="140" height="34" rx="6" />
        <text class="t2 key" x="470" y={r.y + 0.5}>{r.key}</text>
        <line class="sp-fan" x1="540" y1={r.y} x2="602" y2={r.y} />
        <text class="t1 name" x="650" y={r.y - 7}>{r.name}</text>
        <text class="t2 payload c-ok" x="650" y={r.y + 9}>{r.payload}</text>
      </>
    ))}

    <g class="sp-glyph" transform="translate(622 50)">
      <polygon points="13,0 6.5,11.3 -6.5,11.3 -13,0 -6.5,-11.3 6.5,-11.3" />
      <circle class="dot" cx="0" cy="0" r="3" />
    </g>
    <g class="sp-glyph" transform="translate(622 105)">
      <rect x="-12" y="-12" width="24" height="24" rx="5" />
      <rect class="dot" x="-4" y="-4" width="8" height="8" rx="1.5" />
    </g>
    <g class="sp-glyph" transform="translate(622 160)">
      <circle cx="0" cy="0" r="13" />
      <rect class="dot" x="-4" y="-8" width="8" height="16" rx="4" />
    </g>
    <g class="sp-glyph" transform="translate(622 215)">
      <polygon points="0,-13 13,0 0,13 -13,0" />
      <line x1="-6" y1="0" x2="6" y2="0" />
    </g>
    <g class="sp-glyph" transform="translate(622 270)">
      <rect x="-13" y="-13" width="18" height="16" rx="3" />
      <rect x="-5" y="-3" width="18" height="16" rx="3" />
    </g>
  </svg>
  <figcaption>One spec. One translator per provider. Native payloads, no shims.</figcaption>
</figure>

<style>
  .sp {
    max-width: 60rem;
    margin: 1.5rem auto 2rem;
    color: var(--sl-color-text);
  }

  .sp svg {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  text {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    fill: var(--sl-color-gray-3);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .t1 {
    font-family: var(--sl-font);
    font-size: 13px;
    font-weight: 600;
    fill: var(--sl-color-text);
    text-anchor: start;
  }

  .file {
    font-family: var(--sl-font-mono);
    font-size: 12px;
  }

  .code {
    text-anchor: start;
    fill: var(--sl-color-gray-2);
  }

  .payload {
    text-anchor: start;
  }

  .c-ok {
    fill: var(--mh-ok);
  }

  .sp-card,
  .sp-box {
    fill: var(--mh-surface);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }

  .sp-card {
    stroke: var(--mh-ok);
  }

  .sp-card-rule {
    stroke: var(--sl-color-hairline);
    stroke-width: 1;
  }

  .sp-fan {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
    marker-end: url(#sp-arrow);
  }

  .sp-arrowhead {
    fill: var(--sl-color-gray-4);
  }

  .sp-glyph {
    fill: var(--mh-surface);
    stroke: var(--mh-ok);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .sp-glyph .dot {
    fill: var(--mh-ok);
    stroke: none;
  }

  @media (min-width: 72rem) {
    .t1 { font-size: 14px; }
    .file { font-size: 13px; }
    .head, .key, .payload { font-size: 12px; }
  }

  @media (max-width: 40rem) {
    .t2 { display: none; }
    .t1 { font-size: 24px; }
    .file { font-size: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp * {
      animation: none;
      transition: none;
    }
  }
</style>
