<figure class="hf">
  <svg
    viewBox="0 0 960 420"
    role="img"
    aria-labelledby="hf-title hf-desc"
    aria-label="A trimaran seen from above. Three hulls are three GPU providers: Kubernetes, Modal and RunPod. Requests from one URL reach the router and flow to the primary hull. When the primary circuit opens, traffic reroutes to Modal with zero errors, then returns once Kubernetes passes its half-open ramp."
  >
    <title id="hf-title">Per-request failover across three providers</title>
    <desc id="hf-desc">
      Requests from one URL on the left reach the router ahead of the hulls, cross the forward beam and flow to the Kubernetes hull.
      Its circuit opens, the status pill turns coral and the stream moves to Modal within one beat while the error counter stays at zero.
      Kubernetes recovers through an amber half-open ramp and traffic returns.
    </desc>

    <defs>
      <path id="hf-hull-shape" d="M16-20H340Q395-14 410 0Q395 14 340 20H16Q0 20 0 0Q0-20 16-20Z" />
      <path id="hf-wave" vector-effect="non-scaling-stroke" d="M0 0q10-8 20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0t20 0" />
      <clipPath id="hf-spark-clip"><rect x="0" y="-14" width="400" height="28" /></clipPath>
      <g id="hf-mark" stroke-width="4" stroke-linecap="round" fill="none">
        <line x1="12" y1="10" x2="12" y2="54" />
        <line x1="32" y1="6" x2="32" y2="58" />
        <line x1="52" y1="10" x2="52" y2="54" />
        <line x1="12" y1="24" x2="52" y2="24" />
        <line x1="12" y1="42" x2="52" y2="42" />
      </g>
    </defs>

    <rect class="hf-water" x="0" y="38" width="960" height="382" />
    <line class="hf-horizon" x1="0" y1="38" x2="960" y2="38" />

    <g class="hf-legend t2">
      <circle class="c-ok" cx="708" cy="21" r="4" />
      <text class="t2" x="718" y="21">closed</text>
      <circle class="c-down" cx="782" cy="21" r="4" />
      <text class="t2" x="792" y="21">open</text>
      <circle class="c-warn" cx="846" cy="21" r="4" />
      <text class="t2" x="856" y="21">half-open</text>
    </g>

    <rect class="hf-url" x="40" y="189" width="190" height="32" rx="16" />
    <text class="t2 url" x="135" y="205.5">llama.api.acme.com</text>
    <text class="t-narrow" x="135" y="205.5">one URL</text>

    <rect class="hf-counter t2" x="40" y="236" width="98" height="24" rx="12" />
    <text class="t1 c-ok counter" x="89" y="248.5">0 errors</text>
    <rect class="hf-counter muted t2" x="146" y="236" width="84" height="24" rx="12" />
    <text class="t2 counter ph-a" x="188" y="248.5">failovers 0</text>
    <text class="t2 counter ph-bcd" x="188" y="248.5">failovers 1</text>

    <line class="hf-lane" x1="230" y1="205" x2="364" y2="205" />
    <line class="hf-beam" x1="416" y1="205" x2="470" y2="205" />

    <g class="hf-hull" transform="translate(440 100)">
      <use class="hf-hull-body" href="#hf-hull-shape" />
      <text class="t2 badge" x="52" y="0.5">P1</text>
      <circle class="hf-dock" cx="80" cy="0" r="4" />
      <text class="t1 name" x="175" y="-3">Kubernetes</text>
      <text class="t2 spec" x="175" y="11">2 x L4</text>
      <g class="hf-breaker breaker1" transform="translate(224 0)">
        <circle cx="0" cy="0" r="2.5" />
        <circle cx="16" cy="0" r="2.5" />
        <rect class="hf-arm arm1" x="0" y="-1.25" width="14" height="2.5" />
      </g>
      <rect class="hf-pill pill1" x="290" y="-9" width="72" height="18" rx="9" />
      <text class="t2 pill-text c-ok ph-ad" x="326" y="0.5">closed</text>
      <text class="t2 pill-text c-down ph-b" x="326" y="0.5">open</text>
      <text class="t2 pill-text c-warn ph-c" x="326" y="0.5">half-open</text>
      <g transform="translate(0 34)" clip-path="url(#hf-spark-clip)">
        <g class="hf-health health1">
          <g class="hf-scroll"><use href="#hf-wave" /></g>
        </g>
      </g>
    </g>

    <g class="hf-hull" transform="translate(440 205)">
      <use class="hf-hull-body" href="#hf-hull-shape" />
      <text class="t2 badge" x="52" y="0.5">P2</text>
      <circle class="hf-dock" cx="80" cy="0" r="4" />
      <text class="t1 name" x="175" y="-3">Modal</text>
      <text class="t2 spec" x="175" y="11">1 x A10G</text>
      <g class="hf-breaker" transform="translate(224 0)">
        <circle cx="0" cy="0" r="2.5" />
        <circle cx="16" cy="0" r="2.5" />
        <rect class="hf-arm" x="0" y="-1.25" width="14" height="2.5" />
      </g>
      <rect class="hf-pill" x="290" y="-9" width="72" height="18" rx="9" />
      <text class="t2 pill-text c-ok" x="326" y="0.5">closed</text>
      <g transform="translate(0 34)" clip-path="url(#hf-spark-clip)">
        <g class="hf-health health2">
          <g class="hf-scroll"><use href="#hf-wave" /></g>
        </g>
      </g>
    </g>

    <g class="hf-hull" transform="translate(440 310)">
      <use class="hf-hull-body" href="#hf-hull-shape" />
      <text class="t2 badge" x="52" y="0.5">P3</text>
      <circle class="hf-dock" cx="80" cy="0" r="4" />
      <text class="t1 name" x="175" y="-3">RunPod</text>
      <text class="t2 spec" x="175" y="11">1 x L4</text>
      <g class="hf-breaker" transform="translate(224 0)">
        <circle cx="0" cy="0" r="2.5" />
        <circle cx="16" cy="0" r="2.5" />
        <rect class="hf-arm" x="0" y="-1.25" width="14" height="2.5" />
      </g>
      <rect class="hf-pill" x="290" y="-9" width="72" height="18" rx="9" />
      <text class="t2 pill-text c-ok" x="326" y="0.5">closed</text>
      <g transform="translate(0 34)" clip-path="url(#hf-spark-clip)">
        <g class="hf-health">
          <g class="hf-scroll"><use href="#hf-wave" /></g>
        </g>
      </g>
    </g>

    <line class="hf-beam" x1="470" y1="100" x2="470" y2="310" />
    <line class="hf-beam" x1="690" y1="100" x2="690" y2="310" />

    <rect class="hf-router" x="364" y="179" width="52" height="52" rx="10" />
    <use class="hf-router-mark" href="#hf-mark" transform="translate(378 184) scale(0.375)" />
    <text class="t2 router-label" x="390" y="220">router</text>

    <circle class="hf-pkt p1" r="4.5" />
    <circle class="hf-pkt p2" r="4.5" />
    <circle class="hf-pkt p3" r="4.5" />
    <circle class="hf-pkt p4" r="4.5" />
    <circle class="hf-probe q1" r="3.5" />
    <circle class="hf-probe q2" r="3.5" />
    <circle class="hf-probe q3" r="3.5" />

    <text class="t2 caption ph-a" x="40" y="392">All circuits closed. Requests flow to priority 1.</text>
    <text class="t2 caption ph-b" x="40" y="392">Kubernetes circuit opens. Next request lands on Modal. Callers see zero errors.</text>
    <text class="t2 caption ph-c" x="40" y="392">Half-open: admit 1 request, then 5%, 25%, 100%.</text>
    <text class="t2 caption ph-d" x="40" y="392">Recovered. Traffic returns to priority 1.</text>
  </svg>
</figure>

<style>
