    .health1 use { animation: hf-stroke1 12s linear infinite; }
    .health2 { animation: hf-health2 12s ease-in-out infinite; }

    .ph-a { animation: hf-ph-a 12s steps(1, end) infinite; }
    .ph-b { animation: hf-ph-b 12s steps(1, end) infinite; }
